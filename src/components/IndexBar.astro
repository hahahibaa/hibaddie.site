---
// The sheet index: a vertical rail on desktop, a scrolling strip on small screens.
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;

const items = [
  { num: 'LV 0', label: 'About me', id: 'cover' },
  { num: 'LV 1', label: 'Experience', id: 'work', children: [{ label: 'Achievements', id: 'achievements' }] },
  { num: 'LV 2', label: 'Builds', id: 'projects', children: [{ label: 'On the bench', id: 'on-the-bench' }] },
  { num: 'LV 3', label: 'Readings', id: 'reading' },
  { num: 'LV 4', label: 'Gallery', id: 'gallery' },
  { num: 'LV 5', label: 'Next run', id: 'upcoming' },
];

const href = (id: string) => (home ? `#${id}` : `/#${id}`);
---

<nav class="rail" aria-label="Sections">
  <a class="sig" href="/">Hiba Khan <span>— hibaddie.co</span></a>
  <ul class="idx">
    {
      items.map((item) => (
        <li>
          <a href={href(item.id)} data-sec={item.id}>
            <em>{item.num}</em>
            {item.label}
          </a>
          {item.children && (
            <ul class="sub">
              {item.children.map((child) => (
                <li>
                  <a href={href(child.id)} data-sec={child.id}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

{
  home && (
    <script is:inline>
      {(() => {
        const links = [...document.querySelectorAll('.idx a[data-sec]')];
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((l) => l.classList.toggle('on', l.dataset.sec === e.target.id));
              }
            });
          },
          { rootMargin: '-35% 0px -60% 0px' },
        );
        links.forEach((l) => {
          const el = document.getElementById(l.dataset.sec);
          if (el) io.observe(el);
        });
      })()}
    </script>
  )
}
