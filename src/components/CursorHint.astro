---
// The nudge chip.
// Hover devices: it follows the cursor across a row.
// Touch devices: it slides up as you scroll a row into view, then leaves.
---

<script is:inline>
  (() => {
    const hints = document.querySelectorAll('.hint');
    if (!hints.length) return;

    // JS is running, so the static inline chips can step aside
    document.documentElement.classList.add('js-hints');

    const canHover = window.matchMedia('(hover: hover)').matches;

    const tip = document.createElement('a');
    tip.className = 'cursor-hint' + (canHover ? '' : ' is-touch');
    tip.setAttribute('aria-hidden', 'true');
    tip.tabIndex = -1;
    document.body.appendChild(tip);

    let hideTimer, settleTimer;

    const fill = (hint) => {
      tip.href = hint.getAttribute('href');
      tip.innerHTML = hint.innerHTML;
    };

    const show = () => {
      clearTimeout(hideTimer);
      requestAnimationFrame(() => {
        tip.classList.add('on');
        // on touch there is no cursor to settle, so it is tappable immediately
        if (!canHover) tip.classList.add('settled');
      });
      // five seconds, then it gets out of the way
      hideTimer = setTimeout(() => tip.classList.remove('on', 'settled'), canHover ? 5000 : 7000);
    };

    const hide = () => {
      clearTimeout(hideTimer);
      clearTimeout(settleTimer);
      tip.classList.remove('on', 'settled');
    };

    if (canHover) {
      const place = (e) => {
        tip.style.left = Math.min(e.clientX + 16, window.innerWidth - 250) + 'px';
        tip.style.top = e.clientY + 18 + 'px';
      };

      hints.forEach((hint) => {
        const entry = hint.closest('.entry, .card, .nudge-only');

        entry.addEventListener('mouseenter', (e) => {
          fill(hint);
          place(e);
          show();
        });

        entry.addEventListener('mousemove', (e) => {
          if (!tip.classList.contains('on')) return;
          if (!tip.classList.contains('settled')) place(e);
          clearTimeout(settleTimer);
          tip.classList.remove('settled');
          // once the cursor rests, stop chasing so it can be clicked
          settleTimer = setTimeout(() => tip.classList.add('settled'), 220);
        });

        entry.addEventListener('mouseleave', (e) => {
          if (e.relatedTarget === tip) return;
          hide();
        });
      });

      tip.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      tip.addEventListener('mouseleave', hide);
      tip.addEventListener('click', hide);
      return;
    }

    // ---- touch: a small chip pops where the finger lands ----
    const place = (x, y) => {
      const w = tip.offsetWidth || 190;
      tip.style.left = Math.max(10, Math.min(x - w / 2, window.innerWidth - w - 10)) + 'px';
      tip.style.top = Math.max(10, y - 74) + 'px';
    };

    hints.forEach((hint) => {
      const entry = hint.closest('.entry, .card, .nudge-only') || hint.parentElement;
      entry.addEventListener(
        'touchstart',
        (e) => {
          const t = e.touches[0];
          if (!t) return;
          fill(hint);
          tip.hidden = false;
          tip.classList.remove('pressed');
          // show it on this frame — no waiting for a fade
          tip.classList.add('on');
          place(t.clientX, t.clientY);
          requestAnimationFrame(() => place(t.clientX, t.clientY));
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => tip.classList.remove('on'), 4000);
        },
        { passive: true },
      );
    });

    // pressed state by hand: :active lingers on touch screens
    tip.addEventListener('touchstart', () => tip.classList.add('pressed'), { passive: true });
    ['touchend', 'touchcancel'].forEach((ev) =>
      tip.addEventListener(ev, () => setTimeout(() => tip.classList.remove('pressed'), 120), { passive: true }),
    );

    // tapping it follows the link and clears it straight away
    tip.addEventListener('click', () => {
      clearTimeout(hideTimer);
      tip.classList.remove('on', 'pressed');
    });

    // a scroll means they have moved on
    window.addEventListener(
      'scroll',
      () => {
        if (!tip.classList.contains('on')) return;
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => tip.classList.remove('on', 'pressed'), 1200);
      },
      { passive: true },
    );
  })();
</script>
