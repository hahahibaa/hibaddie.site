---
// The sheet index: a vertical rail on desktop, a scrolling strip on small screens.
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;

const items = [
  { num: 'LV 0', label: 'About me', id: 'cover' },
  { num: 'LV 1', label: 'Experience', id: 'work', children: [{ label: 'Achievements', id: 'achievements' }] },
  { num: 'LV 2', label: 'Builds', id: 'projects' },
  { num: 'LV 3', label: 'Now & next', id: 'nownext' },
  { num: 'LV 4', label: 'Gallery', id: 'gallery' },
  // Reading is parked: { num: 'LV 5', label: 'Readings', id: 'reading' },
];

const href = (id: string) => (home ? `#${id}` : `/#${id}`);
---

<nav class="rail" aria-label="Sections">
  <div class="rail-top">
    <a class="sig" href="/">Hiba Khan <span>— hibaddie.co</span></a>
    <button class="rail-toggle" id="rail-toggle" type="button" aria-expanded="false" aria-controls="rail-list">
      levels ▾
    </button>
  </div>
  <ul class="idx" id="rail-list">
    {
      items.map((item) => (
        <li>
          <a href={href(item.id)} data-sec={item.id}>
            <em>{item.num}</em>
            {item.label}
          </a>
          {item.children && (
            <ul class="sub">
              {item.children.map((child) => (
                <li>
                  <a href={href(child.id)} data-sec={child.id}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<script is:inline>
  // phones: the level list hides behind a button so the name comes first
  (() => {
    const btn = document.getElementById('rail-toggle');
    const list = document.getElementById('rail-list');
    if (!btn || !list) return;
    const close = () => {
      list.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    };
    btn.addEventListener('click', () => {
      const open = list.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    list.addEventListener('click', (e) => {
      if (e.target.closest('a')) close();
    });
  })();
</script>

{
  home && (
    <script is:inline>
      {(() => {
        const links = [...document.querySelectorAll('.idx a[data-sec]')];
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((l) => l.classList.toggle('on', l.dataset.sec === e.target.id));
              }
            });
          },
          { rootMargin: '-35% 0px -60% 0px' },
        );
        links.forEach((l) => {
          const el = document.getElementById(l.dataset.sec);
          if (el) io.observe(el);
        });
      })()}
    </script>
  )
}
