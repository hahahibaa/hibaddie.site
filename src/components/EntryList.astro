---
export interface Item {
  title: string;
  href?: string;
  description?: string;
  note?: string;
  code?: string;
  meta?: string;
  metaSub?: string[];
  hint?: { href: string; q: string; go: string };
}

interface Props {
  items: Item[];
  empty?: string;
}

const { items, empty = 'Nothing here yet.' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="muted">{empty}</p>
  ) : (
    <div class="entries">
      {items.map((item) => (
        <article class="entry">
          <span class="code">{item.code ?? '—'}</span>
          <div>
            <h3>
              {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              {item.hint && (
                <a class="hint" href={item.hint.href}>
                  <img class="chip-cat" src="/cat.gif" alt="" width="38" height="33" />
                  <span>
                    <span class="hint-q">{item.hint.q}</span>
                    <span class="hint-go">{item.hint.go}</span>
                  </span>
                </a>
              )}
            </h3>
            {item.description && <p class="body">{item.description}</p>}
            {item.note && <p class="note-line">{item.note}</p>}
          </div>
          <div class="meta">
            {item.meta && <b>{item.meta}</b>}
            {(item.metaSub ?? []).map((line) => (
              <Fragment>
                {line}
                <br />
              </Fragment>
            ))}
          </div>
        </article>
      ))}
    </div>
  )
}
