---
export interface Item {
  title: string;
  href?: string;
  description?: string;
  code?: string;
  meta?: string;
  metaSub?: string[];
}

interface Props {
  items: Item[];
  empty?: string;
}

const { items, empty = 'Nothing here yet.' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="muted">{empty}</p>
  ) : (
    <div class="entries">
      {items.map((item) => (
        <article class="entry">
          <span class="code">{item.code ?? '—'}</span>
          <div>
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            {item.description && <p class="body">{item.description}</p>}
          </div>
          <div class="meta">
            {item.meta && <b>{item.meta}</b>}
            {(item.metaSub ?? []).map((line) => (
              <Fragment>
                {line}
                <br />
              </Fragment>
            ))}
          </div>
        </article>
      ))}
    </div>
  )
}
