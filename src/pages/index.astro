---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byDateDesc } from '../lib/utils';

const intro = (await getEntry('home', 'intro'))!;
const about = (await getEntry('home', 'about'))!;
const experience = (await getEntry('home', 'experience'))!;
const achievements = (await getEntry('home', 'achievements'))!;
const now = (await getEntry('home', 'now'))!;
const upcoming = (await getEntry('home', 'upcoming'))!;
const gallery = (await getEntry('home', 'gallery'))!;
// Reading is parked — content still lives in src/content/home/reading.md.
// const reading = (await getEntry('home', 'reading'))!;

const { Content: About } = await render(about);

const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDateDesc);

// a research audience reads robotics and soft robotics first
const featuredOrder = ['sun-bot', 'soft-finger-sim', 'impedance-measurement'];
const featured = featuredOrder
  .map((id) => allProjects.find((p) => p.id === id))
  .filter(Boolean) as typeof allProjects;
const rest = allProjects.filter((p) => !featuredOrder.includes(p.id));

const bench = (await getCollection('bench', (e) => !e.data.draft)).sort(byDateDesc);

const links = intro.data.links ?? [];
const chips = achievements.data.chips ?? [];
const roles = experience.data.items ?? [];
const groups = (gallery.data.groups ?? []).filter((g) => g.media.length > 0);

const pad = (n: number) => String(n).padStart(2, '0');
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);

const briefRows = (b: Record<string, string | undefined>) =>
  (
    [
      ['Problem', b.problem],
      ['What I built', b.built],
      ['Results', b.results],
      ['What failed', b.failed],
      ['Next', b.next],
    ] as [string, string | undefined][]
  ).filter((row): row is [string, string] => Boolean(row[1]));
---

<Base home>
  <!-- ========== 00 ABOUT ME ========== -->
  <section id="cover" class="cover">
    <div class="covergrid">
      <div>
        <h1>{intro.data.name} Khan</h1>
        <p class="lede">{intro.data.tagline}</p>
        <p class="ways">
          {
            links.map((l, i) => (
              <Fragment>
                {i > 0 && (
                  <span class="sep" aria-hidden="true">
                    /
                  </span>
                )}
                <a href={l.href}>{l.label}</a>
              </Fragment>
            ))
          }
        </p>
      </div>
      <figure class="portrait">
        <img src={intro.data.photo} width="190" height="190" alt="Portrait of Hiba Khan" />
      </figure>
    </div>

    <h2 class="cover-label">About me</h2>
    <div class="cover-body prose"><About /></div>

    <div class="entry nudge-only">
      <h3>
        <a class="hint" href="#work">
          <img class="chip-cat" src="/cat.gif" alt="" width="38" height="33" />
          <span>
            <span class="hint-q">Wanna see where I've been?</span>
            <span class="hint-go">▸ enter the experience</span>
          </span>
        </a>
      </h3>
    </div>
    <div class="rule"></div>
  </section>

  <!-- ========== 01 EXPERIENCE ========== -->
  <section id="work">
    <div class="shead">
      <span class="snum">LV 1</span>
      <div><h2>Experience</h2></div>
      <p class="blurb">Tap a role to open it.</p>
    </div>

    <div class="cards">
      {
        roles.map((role) => (
          <details class="card">
            <summary>
              <span class="card-role">{role.title}</span>
              {role.org && <span class="org">{role.org}</span>}
              <span class="card-when">{role.period}</span>
            </summary>
            {role.description && <p class="card-body">{role.description}</p>}
            {role.href && (
              <p class="card-link">
                <a href={role.href}>read more →</a>
              </p>
            )}
            <a class="hint" href="#projects">
              <img class="chip-cat" src="/cat.gif" alt="" width="38" height="33" />
              <span>
                <span class="hint-q">Wanna see what I build?</span>
                <span class="hint-go">▸ enter the builds</span>
              </span>
            </a>
          </details>
        ))
      }
    </div>

    <h3 id="achievements" class="snum sub">Achievements</h3>
    <ul class="chips">
      {
        chips.map((c) => (
          <li class="chip">
            <b>{c.label}</b>
            {c.where && <span>{c.where}</span>}
            {c.year && <em>{c.year}</em>}
          </li>
        ))
      }
    </ul>
    <div class="rule"></div>
  </section>

  <!-- ========== 02 BUILDS ========== -->
  <section id="projects">
    <div class="shead">
      <span class="snum">LV 2</span>
      <div><h2>Builds</h2></div>
      <p class="blurb">Three worth reading first. Tap for the short version, or open the full log.</p>
    </div>

    <div class="cards">
      {
        featured.map((p) => (
          <details class="card feat">
            <summary>
              <span class="card-role">{p.data.title}</span>
              <span class="card-when">{p.data.date.getUTCFullYear()}</span>
              <span class="card-sub">{p.data.description}</span>
            </summary>

            {p.data.brief ? (
              <dl class="brief">
                {briefRows(p.data.brief).map(([k, v]) => (
                  <Fragment>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </Fragment>
                ))}
              </dl>
            ) : (
              <p class="card-body">TODO: add a brief for this project.</p>
            )}

            <a class="hint" href={p.data.gallery ? `#g-${p.data.gallery}` : '#gallery'}>
              <img class="chip-cat" src="/cat.gif" alt="" width="38" height="33" />
              <span>
                <span class="hint-q">Wanna see the pictures?</span>
                <span class="hint-go">▸ enter the gallery</span>
              </span>
            </a>
            <p class="card-link">
              <a href={`/projects/${p.id}/`}>full log →</a>
              {p.data.repo && <a href={p.data.repo}>code →</a>}
              {p.data.gallery && <a href={`#g-${p.data.gallery}`}>pictures →</a>}
            </p>
          </details>
        ))
      }
    </div>

    <details class="showall">
      <summary>
        <span>Everything else</span>
        <em>{rest.length} more</em>
      </summary>
      <ul class="minigrid">
        {
          rest.map((p) => (
            <li>
              <a href={`/projects/${p.id}/`}>
                <strong>{p.data.title}</strong>
                <span>{p.data.description}</span>
                <em>{p.data.date.getUTCFullYear()}</em>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <div class="rule"></div>
  </section>

  <!-- ========== 03 NOW & NEXT ========== -->
  <section id="nownext">
    <div class="shead">
      <span class="snum">LV 3</span>
      <div><h2>Now &amp; next</h2></div>
      <p class="blurb">On the bench, and what starts in December at <span class="org">IIT Bombay</span>.</p>
    </div>

    <ul class="minigrid two">
      {
        [
          ...bench.map((b) => ({
            title: b.data.title,
            desc: b.data.description,
            tag: b.data.status ?? 'on the bench',
            href: `/bench/${b.id}/` as string | undefined,
          })),
          ...(now.data.items ?? []).map((item) => ({
            title: item.title,
            desc: item.description,
            tag: 'in progress',
            href: item.href as string | undefined,
          })),
          ...(upcoming.data.items ?? []).map((item) => ({
            title: item.title,
            desc: item.description,
            tag: 'Dec — IIT Bombay',
            href: undefined as string | undefined,
          })),
        ].map((item) => (
          <li>
            {item.href ? (
              <a href={item.href}>
                <strong>{item.title}</strong>
                {item.desc && <span>{item.desc}</span>}
                <em>{item.tag}</em>
              </a>
            ) : (
              <div>
                <strong>{item.title}</strong>
                {item.desc && <span>{item.desc}</span>}
                <em>{item.tag}</em>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <div class="rule"></div>
  </section>

  {
    /* ---- READING — parked. Content kept in src/content/home/reading.md;
       re-add the nav item in IndexBar.astro and restore this block to bring it back.
    <section id="reading">
      <div class="shead">
        <span class="snum">LV X</span>
        <div><h2>Readings</h2></div>
        <p class="blurb">What I'm reading to get good at this.</p>
      </div>
    </section>
    ---- */
  }

  <!-- ========== 04 GALLERY ========== -->
  <section id="gallery">
    <div class="shead">
      <span class="snum">LV 4</span>
      <div><h2>Gallery</h2></div>
      <p class="blurb">Tap any picture to open it — or use the drawer in the corner, it follows you around.</p>
    </div>

    {
      groups.map((group, gi) => (
        <div class="plate-group" id={`g-${group.slug}`}>
          <h3 class="group-head">
            <span class="snum">04.{gi + 1}</span>
            {group.title}
            <em class="count">{group.media.length}</em>
          </h3>
          <div class="thumbs" data-gallery-scope>
            {group.media.map((m, mi) => (
              <button
                class="thumb"
                type="button"
                data-src={m.src}
                data-caption={m.caption ?? group.title}
                data-plate={`PL ${pad(gi + 1)}.${mi + 1}`}
                aria-label={`Open ${m.caption ?? group.title} — ${group.title}`}
              >
                {isVideo(m.src) ? (
                  <Fragment>
                    <img
                      src={m.poster ?? '/profile.svg'}
                      alt={`${m.caption ?? group.title} — ${group.title}, video`}
                      loading="lazy"
                      width="104"
                      height="78"
                    />
                    <span class="play" aria-hidden="true">
                      ▶
                    </span>
                  </Fragment>
                ) : (
                  <img
                    src={m.src}
                    alt={`${m.caption ?? group.title} — ${group.title}`}
                    loading="lazy"
                    width="104"
                    height="78"
                  />
                )}
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>
