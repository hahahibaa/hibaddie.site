---
// The nudge chip.
// Hover devices: it follows the cursor across a row.
// Touch devices: it slides up as you scroll a row into view, then leaves.
---

<script is:inline>
  (() => {
    const hints = document.querySelectorAll('.entry .hint');
    if (!hints.length) return;

    // JS is running, so the static inline chips can step aside
    document.documentElement.classList.add('js-hints');

    const canHover = window.matchMedia('(hover: hover)').matches;

    const tip = document.createElement('a');
    tip.className = 'cursor-hint' + (canHover ? '' : ' is-toast');
    tip.setAttribute('aria-hidden', 'true');
    tip.tabIndex = -1;
    document.body.appendChild(tip);

    let hideTimer, settleTimer;

    const fill = (hint) => {
      tip.href = hint.getAttribute('href');
      tip.innerHTML = hint.innerHTML;
    };

    const show = () => {
      clearTimeout(hideTimer);
      requestAnimationFrame(() => tip.classList.add('on'));
      // five seconds, then it gets out of the way
      hideTimer = setTimeout(() => tip.classList.remove('on', 'settled'), 5000);
    };

    const hide = () => {
      clearTimeout(hideTimer);
      clearTimeout(settleTimer);
      tip.classList.remove('on', 'settled');
    };

    if (canHover) {
      const place = (e) => {
        tip.style.left = Math.min(e.clientX + 16, window.innerWidth - 250) + 'px';
        tip.style.top = e.clientY + 18 + 'px';
      };

      hints.forEach((hint) => {
        const entry = hint.closest('.entry');

        entry.addEventListener('mouseenter', (e) => {
          fill(hint);
          place(e);
          show();
        });

        entry.addEventListener('mousemove', (e) => {
          if (!tip.classList.contains('on')) return;
          if (!tip.classList.contains('settled')) place(e);
          clearTimeout(settleTimer);
          tip.classList.remove('settled');
          // once the cursor rests, stop chasing so it can be clicked
          settleTimer = setTimeout(() => tip.classList.add('settled'), 220);
        });

        entry.addEventListener('mouseleave', (e) => {
          if (e.relatedTarget === tip) return;
          hide();
        });
      });

      tip.addEventListener('mouseenter', () => clearTimeout(hideTimer));
      tip.addEventListener('mouseleave', hide);
      tip.addEventListener('click', hide);
      return;
    }

    // ---- touch: the chip rides along as you scroll ----
    tip.classList.add('settled');
    let current = null;

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((e) => e.isIntersecting);
        if (!visible) return;
        const hint = visible.target.querySelector('.hint');
        if (!hint || hint === current) return;
        current = hint;
        fill(hint);
        show();
      },
      // a narrow band across the middle of the screen
      { rootMargin: '-42% 0px -42% 0px' },
    );

    hints.forEach((hint) => io.observe(hint.closest('.entry')));
    tip.addEventListener('click', hide);
  })();
</script>
