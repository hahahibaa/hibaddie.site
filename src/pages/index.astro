---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { byDateDesc } from '../lib/utils';

const intro = (await getEntry('home', 'intro'))!;
const about = (await getEntry('home', 'about'))!;
const experience = (await getEntry('home', 'experience'))!;
const achievements = (await getEntry('home', 'achievements'))!;
const now = (await getEntry('home', 'now'))!;
const reading = (await getEntry('home', 'reading'))!;
const gallery = (await getEntry('home', 'gallery'))!;
const upcoming = (await getEntry('home', 'upcoming'))!;

const { Content: About } = await render(about);
const { Content: Achievements } = await render(achievements);

const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDateDesc);
const featured = allProjects.filter((p) => p.data.featured);
const bench = (await getCollection('bench', (e) => !e.data.draft)).sort(byDateDesc);

const links = intro.data.links ?? [];
const meta = intro.data.meta ?? [];
const groups = (gallery.data.groups ?? []).filter((g) => g.media.length > 0);
const readingItems = reading.data.items ?? [];

const pad = (n: number) => String(n).padStart(2, '0');
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
---

<Base home>
  <!-- ========== 00 FRONT ========== -->
  <section id="cover" class="cover">
    <div class="covergrid">
      <div>
        <h1>{intro.data.name} Khan</h1>
        <p class="lede">{intro.data.tagline}</p>
        <p class="ways">
          {
            links.map((l, i) => (
              <Fragment>
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                <a href={l.href}>{l.label}</a>
              </Fragment>
            ))
          }
        </p>
      </div>
      <figure class="portrait">
        <img src={intro.data.photo} width="190" height="190" alt="Portrait of Hiba Khan" />
      </figure>
    </div>

    {
      meta.length > 0 && (
        <dl class="tblock">
          {meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <h2 class="cover-label">About me</h2>
    <div class="cover-body prose"><About /></div>
    <div class="rule"></div>
  </section>

  <!-- ========== 01 EXPERIENCE ========== -->
  <section id="work">
    <div class="shead">
      <span class="snum">01</span>
      <div><h2>Experience</h2></div>
      <p class="blurb">Research, instrumentation, and one company I co-founded at sixteen.</p>
    </div>

    <EntryList
      items={(experience.data.items ?? []).map((item, i) => ({
        code: `01.${i + 1}`,
        title: item.org ? `${item.title} — ${item.org}` : item.title,
        href: item.href,
        description: item.description,
        meta: item.period,
      }))}
    />

    <h3 id="achievements" class="snum" style="margin:38px 0 10px">Selected achievements</h3>
    <div class="prose muted"><Achievements /></div>
    <div class="rule"></div>
  </section>

  <!-- ========== 02 PROJECTS ========== -->
  <section id="projects">
    <div class="shead">
      <span class="snum">02</span>
      <div><h2>Projects</h2></div>
      <p class="blurb">Each entry opens its own sheet — build log, figures, and what I got wrong.</p>
    </div>

    <EntryList
      items={featured.map((p, i) => ({
        code: `02.${pad(i + 1)}`,
        title: p.data.title,
        href: `/projects/${p.id}/`,
        description: p.data.description,
        meta: String(p.data.date.getUTCFullYear()),
        metaSub: p.data.tools.slice(0, 3),
      }))}
    />

    <p class="more"><a href="/projects/">All {allProjects.length} projects →</a></p>

    <h3 id="on-the-bench" class="snum" style="margin:46px 0 10px">On the bench</h3>
    <EntryList
      items={[
        ...(now.data.items ?? []).map((item) => ({
          code: '··',
          title: item.title,
          href: item.href,
          description: item.description,
          meta: 'in progress',
        })),
        ...bench.map((b) => ({
          code: '··',
          title: b.data.title,
          href: `/bench/${b.id}/`,
          description: b.data.description,
          meta: b.data.status ?? String(b.data.date.getUTCFullYear()),
        })),
      ]}
    />
    <div class="rule"></div>
  </section>

  <!-- ========== 03 READING ========== -->
  <section id="reading">
    <div class="shead">
      <span class="snum">03</span>
      <div><h2>Reading</h2></div>
      <p class="blurb">What I'm working through, and what I keep going back to.</p>
    </div>

    <EntryList
      empty="List in progress."
      items={readingItems.map((item) => ({
        code: '—',
        title: item.org ? `${item.title} — ${item.org}` : item.title,
        href: item.href,
        description: item.description,
        meta: item.period,
      }))}
    />
    <div class="rule"></div>
  </section>

  <!-- ========== 04 GALLERY ========== -->
  <section id="gallery">
    <div class="shead">
      <span class="snum">04</span>
      <div><h2>Gallery</h2></div>
      <p class="blurb">Build photos, half-finished things, and work still on the bench.</p>
    </div>

    {
      groups.map((group, gi) => (
        <div class="plate-group">
          <h3 class="group-head">
            <span class="snum">04.{gi + 1}</span>
            {group.title}
          </h3>
          <div class="plates">
            {group.media.map((m, mi) => (
              <figure class="plate">
                <div class="frame">
                  {isVideo(m.src) ? (
                    <video src={m.src} muted loop playsinline autoplay preload="metadata" />
                  ) : (
                    <a href={m.src} target="_blank" rel="noopener">
                      <img src={m.src} alt={m.caption ?? group.title} loading="lazy" />
                    </a>
                  )}
                </div>
                <figcaption>
                  <span>{m.caption}</span>
                  <em>
                    PL {pad(gi + 1)}.{mi + 1}
                  </em>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))
    }
  </section>
  <!-- ========== 05 UPCOMING ========== -->
  <section id="upcoming">
    <div class="rule" style="margin-top:0"></div>
    <div class="shead" style="margin-top:56px">
      <span class="snum">05</span>
      <div><h2>Upcoming</h2></div>
      <p class="blurb">Starting December 2026 at IIT Bombay.</p>
    </div>

    <EntryList
      items={(upcoming.data.items ?? []).map((item, i) => ({
        code: `05.${i + 1}`,
        title: item.title,
        description: item.description,
        meta: item.period ?? 'planned',
      }))}
    />
  </section>
</Base>
