---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { byDateDesc } from '../lib/utils';

const intro = (await getEntry('home', 'intro'))!;
const about = (await getEntry('home', 'about'))!;
const experience = (await getEntry('home', 'experience'))!;
const achievements = (await getEntry('home', 'achievements'))!;
const now = (await getEntry('home', 'now'))!;
const reading = (await getEntry('home', 'reading'))!;
const gallery = (await getEntry('home', 'gallery'))!;
const upcoming = (await getEntry('home', 'upcoming'))!;

const { Content: About } = await render(about);
const { Content: Achievements } = await render(achievements);

const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDateDesc);
const featured = allProjects.filter((p) => p.data.featured);
const bench = (await getCollection('bench', (e) => !e.data.draft)).sort(byDateDesc);

const links = intro.data.links ?? [];
const meta = intro.data.meta ?? [];
const groups = (gallery.data.groups ?? []).filter((g) => g.media.length > 0);
const readingLists = (reading.data.lists ?? []).filter((l) => l.items.length > 0);

const pad = (n: number) => String(n).padStart(2, '0');
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
---

<Base home>
  <!-- ========== 00 FRONT ========== -->
  <section id="cover" class="cover">
    <div class="covergrid">
      <div>
        <h1>{intro.data.name} Khan</h1>
        <p class="lede">{intro.data.tagline}</p>
        <p class="ways">
          {
            links.map((l, i) => (
              <Fragment>
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                <a href={l.href}>{l.label}</a>
              </Fragment>
            ))
          }
        </p>
      </div>
      <figure class="portrait">
        <img src={intro.data.photo} width="190" height="190" alt="Portrait of Hiba Khan" />
      </figure>
    </div>

    {
      meta.length > 0 && (
        <dl class="tblock">
          {meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <h2 class="cover-label">Player card</h2>
    <div class="cover-body prose"><About /></div>
    <div class="rule"></div>
  </section>

  <!-- ========== 01 EXPERIENCE ========== -->
  <section id="work">
    <div class="shead">
      <span class="snum">LV 1</span>
      <div><h2>Experience</h2></div>
      <p class="blurb">Where I've been, and what I took apart while I was there.</p>
    </div>

    <EntryList
      items={(experience.data.items ?? []).map((item, i) => ({
        code: `01.${i + 1}`,
        title: item.org ? `${item.title} — ${item.org}` : item.title,
        href: item.href,
        note: item.href ? '▸ open log' : undefined,
        meta: item.period,
        hint: { href: '#projects', q: 'Wanna see what I build?', go: '▸ enter the builds' },
      }))}
    />

    <h3 id="achievements" class="snum" style="margin:38px 0 10px">Trophies</h3>
    <div class="prose muted"><Achievements /></div>
    <div class="rule"></div>
  </section>

  <!-- ========== 02 PROJECTS ========== -->
  <section id="projects">
    <div class="shead">
      <span class="snum">LV 2</span>
      <div><h2>Builds</h2></div>
      <p class="blurb">Main quests. Each one opens its own log — figures, results, and what I got wrong.</p>
    </div>

    <EntryList
      items={featured.map((p, i) => ({
        code: `02.${pad(i + 1)}`,
        title: p.data.title,
        href: `/projects/${p.id}/`,
        note: '▸ open log',
        meta: String(p.data.date.getUTCFullYear()),
        metaSub: p.data.tools.slice(0, 3),
        hint: p.data.gallery
          ? { href: `#g-${p.data.gallery}`, q: 'Wanna see the pictures?', go: '▸ enter the screenshots' }
          : { href: '#work', q: "Wanna see where I've been?", go: '▸ enter the experience' },
      }))}
    />

    <p class="more"><a href="/projects/">▸ all {allProjects.length} builds</a></p>

    <h3 class="snum" style="margin:46px 0 10px">Side quests — in progress</h3>
    <EntryList
      items={(now.data.items ?? []).map((item) => ({
        code: '··',
        title: item.title,
        href: item.href,
        description: item.description,
        meta: 'in progress',
      }))}
    />

    <h3 id="on-the-bench" class="snum" style="margin:46px 0 10px">On the bench</h3>
    <EntryList
      items={bench.map((b) => ({
        code: '··',
        title: b.data.title,
        href: `/bench/${b.id}/`,
        description: b.data.description,
        meta: b.data.status ?? String(b.data.date.getUTCFullYear()),
      }))}
    />
    <div class="rule"></div>
  </section>

  <!-- ========== 03 READING ========== -->
  <section id="reading">
    <div class="shead">
      <span class="snum">LV 3</span>
      <div><h2>Lore</h2></div>
      <p class="blurb">What I'm reading to get good at this.</p>
    </div>

    {
      readingLists.map((list, li) => (
        <div class="plate-group">
          <h3 class="group-head">
            <span class="snum">03.{li + 1}</span>
            {list.title}
          </h3>
          <EntryList
            items={list.items.map((item, ii) => ({
              code: `${li + 1}.${ii + 1}`,
              title: item.title,
              href: item.href,
              description: item.by,
              meta: item.where,
            }))}
          />
        </div>
      ))
    }

    <div class="rule"></div>
  </section>

  <!-- ========== 04 GALLERY ========== -->
  <section id="gallery">
    <div class="shead">
      <span class="snum">LV 4</span>
      <div><h2>Screenshots</h2></div>
      <p class="blurb">Tap a bubble to open it. Build photos, clips, half-finished things.</p>
    </div>

    {
      groups.map((group, gi) => (
        <div class="plate-group" id={`g-${group.slug}`}>
          <h3 class="group-head">
            <span class="snum">04.{gi + 1}</span>
            {group.title}
            <em class="count">{group.media.length}</em>
          </h3>
          <div class="thumbs">
            {group.media.map((m, mi) => (
              <button
                class="thumb"
                type="button"
                data-src={m.src}
                data-caption={m.caption ?? group.title}
                data-plate={`PL ${pad(gi + 1)}.${mi + 1}`}
                aria-label={`Open ${m.caption ?? group.title}`}
              >
                {isVideo(m.src) ? (
                  <Fragment>
                    <video src={`${m.src}#t=0.1`} muted playsinline preload="metadata" />
                    <span class="play" aria-hidden="true">▶</span>
                  </Fragment>
                ) : (
                  <img src={m.src} alt={m.caption ?? group.title} loading="lazy" />
                )}
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </section>
  <!-- ========== 05 UPCOMING ========== -->
  <section id="upcoming">
    <div class="rule" style="margin-top:0"></div>
    <div class="shead" style="margin-top:56px">
      <span class="snum">LV 5</span>
      <div><h2>Next run</h2></div>
      <p class="blurb">Loading December 2026 — IIT Bombay.</p>
    </div>

    <EntryList
      items={(upcoming.data.items ?? []).map((item, i) => ({
        code: `05.${i + 1}`,
        title: item.title,
        description: item.description,
        meta: item.period ?? 'planned',
        hint: { href: '#gallery', q: 'Wanna see the pictures?', go: '▸ enter the screenshots' },
      }))}
    />
  </section>
</Base>
