---
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/silkscreen/400.css';
import '@fontsource/silkscreen/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import IndexBar from '../components/IndexBar.astro';
import Footer from '../components/Footer.astro';
import CursorHint from '../components/CursorHint.astro';
import Lightbox from '../components/Lightbox.astro';
import GalleryLauncher from '../components/GalleryLauncher.astro';

interface Props extends SEOProps {
  home?: boolean;
}

const { home = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <SEO {...seo} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="layout">
      <IndexBar home={home} />
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer />
    <CursorHint />
    <GalleryLauncher />
    <Lightbox />
  </body>
</html>
