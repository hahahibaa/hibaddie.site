---
import { getEntry } from 'astro:content';

const gallery = (await getEntry('home', 'gallery'))!;
const groups = (gallery.data.groups ?? []).filter((g) => g.media.length > 0);

const media = groups.flatMap((group, gi) =>
  group.media.map((m, mi) => ({
    src: m.src,
    cover: m.cover ?? false,
    caption: m.caption ?? group.title,
    group: group.title,
    plate: `PL ${String(gi + 1).padStart(2, '0')}.${mi + 1}`,
  })),
);

// the launcher previews a clip — a still graph is a dull invitation
const cover = media.find((m) => m.cover) ?? media.find((m) => /\.(mp4|webm|mov)$/i.test(m.src)) ?? media[0];
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);

// the launcher cycles every clip first, then the stills, then loops
const clips = media.filter((m) => isVideo(m.src)).map((m) => m.src);
const stills = media.filter((m) => !isVideo(m.src)).map((m) => m.src);
const ordered = cover ? [cover.src, ...clips.filter((s) => s !== cover.src)] : clips;
const playlist = [...ordered, ...stills];
---

{
  media.length > 0 && (
    <Fragment>
      <div class="click-me" id="gal-tease" aria-hidden="true">
        <img src="/cat.gif" alt="" width="40" height="35" />
        <span class="cm-text"><span class="cm-cap">C</span>lick me</span>
        <span class="arrow" aria-hidden="true">→</span>
      </div>

      <button class="launcher" id="gal-launcher" type="button" aria-expanded="false" aria-controls="gal-panel">
        <span class="launcher-media" id="gal-preview" data-playlist={JSON.stringify(playlist)}>
          {cover &&
            (isVideo(cover.src) ? (
              <video class="pv on" src={cover.src} muted autoplay playsinline preload="auto" />
            ) : (
              <img class="pv on" src={cover.src} alt="" />
            ))}
        </span>
        <span class="launcher-label">Gallery</span>
        <span class="launcher-badge">{media.length}</span>
        <span class="sr">Open the picture drawer</span>
      </button>

      <div class="gal-scrim" id="gal-scrim" hidden />

      <section class="gal-panel" id="gal-panel" hidden aria-label="Picture drawer">
        <header class="gal-head">
          <div>
            <strong>Picture drawer</strong>
            <span>{media.length} snippets · tap to open</span>
          </div>
          <button class="gal-close" type="button" aria-label="Close">×</button>
        </header>

        <div class="gal-grid" data-gallery-scope>
          {media.map((m) => (
            <button
              class="thumb"
              type="button"
              data-src={m.src}
              data-caption={m.caption}
              data-plate={m.plate}
              aria-label={`Open ${m.caption}`}
            >
              {isVideo(m.src) ? (
                <Fragment>
                  <video src={`${m.src}#t=0.1`} muted playsinline preload="metadata" />
                  <span class="play" aria-hidden="true">
                    ▶
                  </span>
                </Fragment>
              ) : (
                <img src={m.src} alt={m.caption} loading="lazy" />
              )}
              <span class="thumb-cap">{m.caption}</span>
            </button>
          ))}
        </div>
      </section>
    </Fragment>
  )
}

<script is:inline>
  // the preview runs as a slideshow: each clip plays out, each still holds briefly
  (() => {
    const stage = document.getElementById('gal-preview');
    if (!stage) return;
    const list = JSON.parse(stage.dataset.playlist || '[]');
    if (list.length < 2) return;

    const isVid = (s) => /\.(mp4|webm|mov)$/i.test(s);
    let i = 0;
    let timer;

    const next = () => {
      i = (i + 1) % list.length;
      show(list[i]);
    };

    function show(src) {
      clearTimeout(timer);
      const node = document.createElement(isVid(src) ? 'video' : 'img');
      node.className = 'pv';
      if (isVid(src)) {
        node.muted = true;
        node.autoplay = true;
        node.playsInline = true;
        node.preload = 'auto';
        node.addEventListener('ended', next, { once: true });
        timer = setTimeout(next, 9000); // in case it never fires
      } else {
        node.alt = '';
        timer = setTimeout(next, 3200);
      }
      node.src = src;
      stage.appendChild(node);
      requestAnimationFrame(() => {
        node.classList.add('on');
        const old = [...stage.querySelectorAll('.pv')].slice(0, -1);
        old.forEach((o) => {
          o.classList.remove('on');
          setTimeout(() => o.remove(), 450);
        });
      });
    }

    const first = stage.querySelector('.pv');
    if (first && first.tagName === 'VIDEO') {
      first.addEventListener('ended', next, { once: true });
      timer = setTimeout(next, 9000);
    } else {
      timer = setTimeout(next, 3200);
    }
  })();

  (() => {
    const btn = document.getElementById('gal-launcher');
    const panel = document.getElementById('gal-panel');
    const scrim = document.getElementById('gal-scrim');
    const tease = document.getElementById('gal-tease');
    if (!btn || !panel || !scrim) return;

    let open = false;

    const setOpen = (next) => {
      open = next;
      btn.setAttribute('aria-expanded', String(next));
      if (tease) tease.classList.toggle('gone', next);
      if (next) {
        panel.hidden = false;
        scrim.hidden = false;
        requestAnimationFrame(() => {
          panel.classList.add('on');
          scrim.classList.add('on');
        });
        if (window.matchMedia('(max-width: 760px)').matches) document.body.style.overflow = 'hidden';
      } else {
        panel.classList.remove('on');
        scrim.classList.remove('on');
        document.body.style.overflow = '';
        setTimeout(() => {
          panel.hidden = true;
          scrim.hidden = true;
        }, 220);
      }
    };

    btn.addEventListener('click', () => setOpen(!open));
    scrim.addEventListener('click', () => setOpen(false));
    panel.querySelector('.gal-close').addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open && document.getElementById('lb').hidden) setOpen(false);
    });
  })();
</script>
